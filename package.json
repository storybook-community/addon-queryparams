{
  "name": "@storybook/addon-queryparams",
  "version": "9.0.1",
  "description": "Mock query params in Storybook",
  "keywords": [
    "storybook-addon",
    "storybook",
    "mock",
    "queryparams",
    "URLSearchParams"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/storybook-community/addon-queryparams"
  },
  "license": "MIT",
  "author": "Storybook",
  "type": "module",
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build-storybook": "storybook build",
    "build:watch": "npm run build -- --watch",
    "eject-ts": "zx scripts/eject-typescript.js",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "prepare": "husky",
    "prerelease": "zx scripts/prepublish-checks.js",
    "release": "pnpm build && pnpm semantic-release",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "next",
    "@storybook/icons": "^2.2.0",
    "@storybook/react-vite": "next",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "boxen": "^9.0.0",
    "commitlint": "^21.2.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "next",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "npm-run-all2": "^9.1.0",
    "prettier": "^3.10.1",
    "prompts": "^2.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^26.0.1",
    "storybook": "next",
    "ts-dedent": "^2.3.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zx": "^8.8.5"
  },
  "peerDependencies": {
    "storybook": "^11.0.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bundler": {
    "managerEntries": [],
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ],
    "nodeEntries": []
  },
  "storybook": {
    "displayName": "Query Params (community version)",
    "supportedFrameworks": [
      "supported-frameworks"
    ],
    "icon": "https://avatars.githubusercontent.com/u/216219414?s=200&v=4"
  },
  "packageManager": "pnpm@12.16.1"
}
